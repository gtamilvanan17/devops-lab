# =============================================================================
#  DevOps Lab settings
# =============================================================================
#  Copy this file to lab.env (or run: ./lab.sh init) and uncomment what you want
#  to change. Anything left commented keeps its default.
#
#  Files are read in this order, later ones win:
#    1. built-in defaults in lab.sh
#    2. ~/.config/devops-lab/lab.env   (global, shared by every copy of the lab)
#    3. ./lab.env                      (this copy only)
#    4. $LAB_ENV_FILE                  (optional extra file)
#
#  After changing PORTS or the CLUSTER name run:  lab destroy && lab up
#  (kind cannot change port mappings on a running cluster).
#  Other changes (passwords, heap) apply with:     lab configs && lab start
# =============================================================================

# ----- Cluster ---------------------------------------------------------------
#CLUSTER=lab                  # kind cluster name (lowercase, digits, dashes)
#API_PORT=6443                # Kubernetes API port on your Mac

# ----- Jenkins (own Docker container) ----------------------------------------
#JENKINS_PORT=8080
#JENKINS_USER=admin
#JENKINS_PASS=admin123        # lab only, change it if you like
#JENKINS_HEAP=1g              # Java max heap, e.g. 512m, 2g
#JENKINS_CT=lab-jenkins       # container name
#JENKINS_IMG=lab-jenkins:latest
#JENKINS_HOME_DIR=./jenkins_wp   # use an absolute path to move it elsewhere

# ----- ArgoCD ----------------------------------------------------------------
#ARGOCD_PORT=8081             # port on your Mac
#ARGOCD_NODEPORT=30080        # port on the kind node (rarely needs changing)
#ARGOCD_USER=admin
#DEPLOY_SAMPLE_APP=true       # false = skip the demo apps (podinfo, hello-web)
#GITOPS_DIR=./gitops          # your apps + values files (absolute path to move it)

# ----- Monitoring ------------------------------------------------------------
#GRAFANA_PORT=8082
#GRAFANA_USER=admin
#GRAFANA_PASS=admin123
#PROMETHEUS_PORT=8083
#ALERTMANAGER_PORT=8084
#SPARE_PORT=9090              # free port for your own apps
#GRAFANA_NODEPORT=30082
#PROMETHEUS_NODEPORT=30083
#ALERTMANAGER_NODEPORT=30084
#SPARE_NODEPORT=30090
